---
import Layout from '../../layouts/Layout.astro';
import { posts, href, dateLabel, postHref } from '../../lib/posts';
export function getStaticPaths() { return posts.map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const index = posts.findIndex(p => p.slug === post.slug);
const next = posts[index + 1];
---
<Layout title={post.title} description={post.description} article>
  <article class="article-layout">
    <header class="article-heading"><a class="back" href={href('blog/')}>← 全部文章</a><p class="post-meta">{post.example ? '排版示例' : post.tags.join(' / ') || '随笔'}</p><h1>{post.title}</h1><p class="article-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span>约 {post.minutes} 分钟</span></p>{post.description && <p class="article-deck">{post.description}</p>}</header>
    {post.headings.length > 1 && <aside class="toc"><details open><summary>本篇目录</summary><nav aria-label="文章目录">{post.headings.map(h => <a class:list={{ sub: h.depth === 3 }} href={`#${h.id}`}>{h.text}</a>)}</nav></details></aside>}
    <div class="prose" set:html={post.html} />
    <div class="article-end"><span>写到这里。</span><a href={next ? postHref(next) : href('blog/')}>{next ? `继续阅读：${next.title}` : '返回文章列表'} ↗</a></div>
  </article>
</Layout>
