---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import config from '../../site.config.json';
import { posts, href } from '../lib/posts';
---
<Layout>
  <section class="intro"><p class="eyebrow">{config.title}</p><h1>写下日常，<br />也留下思考。</h1><p class="intro-text">{config.intro}</p><a class="text-link" href={href('about/')}>关于这个博客 <span aria-hidden="true">↗</span></a></section>
  <section class="latest"><div class="section-heading"><h2>最近的文字</h2><a href={href('blog/')}>全部文章 ↗</a></div>
  {posts.length ? <><FeaturedPost post={posts[0]} /><PostList posts={posts.slice(1, 5)} /></> : <p class="empty">第一篇文章，正在路上。</p>}</section>
</Layout>
